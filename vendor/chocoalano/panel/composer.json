{
    "name": "chocoalano/panel",
    "description": "An Inertia + Vue admin panel framework for Laravel: resources, tables, forms, infolists, widgets, actions and multi-panel routing.",
    "keywords": ["laravel", "panel", "admin", "inertia", "vue", "crud", "panda-panel"],
    "homepage": "https://github.com/chocoalano/panda-panel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Alan Gentina",
            "email": "alangentina95@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/chocoalano/panda-panel/issues",
        "source": "https://github.com/chocoalano/panda-panel"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-zip": "*",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^12.0|^13.0",
        "laravel/fortify": "^1.37.2",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "PandaPanel\\": "src/"
        },
        "files": [
            "src/Support/helpers.php",
            "src/Testing/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PandaPanel\\Tests\\": "tests/",
            "Tests\\": "tests/",
            "App\\": "examples/app/",
            "Database\\Factories\\": "examples/database/factories/"
        }
    },
    "scripts": {
        "test": "@php -d memory_limit=512M vendor/bin/pest",
        "test-coverage": "@php -d memory_limit=512M vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "ci": [
            "@format-check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PandaPanel\\PandaPanelServiceProvider"
            ],
            "aliases": {
                "PandaPanel": "PandaPanel\\Facades\\PandaPanel"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
