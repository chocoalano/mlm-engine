{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@chocoalano/panel",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Development toolchain for the Vue frontend that ships with chocoalano/panel. Not published to npm — the components are published into an application by vendor:publish.",
    "license": "MIT",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "lint": "eslint resources/js frontend --max-warnings=0",
        "lint:fix": "eslint resources/js frontend --fix",
        "format": "prettier --write resources/js frontend resources/css",
        "format:check": "prettier --check resources/js frontend resources/css",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
        "test": "vitest run",
        "test:browser": "node tests/browser/frozen-columns.mjs --build",
        "test:browser:verify": "node tests/browser/verify.mjs --build",
        "test:browser:ui6": "node tests/browser/ui6.mjs --build",
        "test:browser:stacked": "node tests/browser/stacked.mjs --build",
        "test:browser:temporal": "node tests/browser/temporal.mjs --build",
        "test:browser:datatable": "node tests/browser/datatable.mjs --build",
        "test:browser:editors": "node tests/browser/editors.mjs --build",
        "test:browser:all": "npm run test:browser && npm run test:browser:verify && npm run test:browser:ui6 && npm run test:browser:stacked && npm run test:browser:temporal && npm run test:browser:datatable && npm run test:browser:editors",
        "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@guolao/vue-monaco-editor": "^1.6.0",
        "@inertiajs/vue3": "^3.0.0",
        "@internationalized/date": "^3.12.0",
        "@laravel/echo-vue": "^2.4.0",
        "@laravel/passkeys": "^0.4.0",
        "@lucide/vue": "^1.31.0",
        "@tailwindcss/vite": "^4.1.0",
        "@tanstack/vue-table": "^9.0.0",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "@tiptap/vue-3": "^3.31.3",
        "@vueuse/core": "^14.0.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "md-editor-v3": "^7.0.0",
        "monaco-editor": "^0.56.0",
        "reka-ui": "^2.0.0",
        "tailwind-merge": "^3.0.0",
        "tailwindcss": "^4.1.0",
        "tw-animate-css": "^1.2.0",
        "vue": "^3.5.0",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^9.20.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "globals": "^17.0.0",
        "happy-dom": "^20.14.0",
        "prettier": "^3.4.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.24.0",
        "vite": "^7.0.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.0.0"
    }
}
